t:parse-p-bad-no-viewer
    a vsont:ParsePTest ;
    mf:name "a document that fails C5 still parses" ;
    rdfs:comment "Syntactic well-formedness is independent of structural well-formedness (docs/vson.md §2.1): this source parses and then fails C5." ;
    vsont:clause "C1" ;
    vsont:section "4.2" , "B" ;
    mf:action <../fixtures/bad_no_viewer.vson> ;
    mf:result vsont:Accepted .

t:parse-p-neg-p1
    a vsont:ParsePTest ;
    mf:name "VSON-P rejects: the lexer meets a character no production admits" ;
    rdfs:comment "Appendix B declares no numbered error set, so the expectation pins the reference parser's message rather than an identifier the specification does not define." ;
    vsont:clause "C1" ;
    vsont:section "4.2" , "B" ;
    mf:action <data/P1_unexpected_character.vson> ;
    mf:result [
        a vsont:ParseError ;
        vsont:errorMessage "Unexpected character: '%'" ;
    ] .

t:parse-p-neg-p2
    a vsont:ParsePTest ;
    mf:name "VSON-P rejects: a node with no variable" ;
    rdfs:comment "Appendix B declares no numbered error set, so the expectation pins the reference parser's message rather than an identifier the specification does not define." ;
    vsont:clause "C1" ;
    vsont:section "4.2" , "B" ;
    mf:action <data/P2_expected_variable.vson> ;
    mf:result [
        a vsont:ParseError ;
        vsont:errorMessage "expected ID, got Tok(kind='/', value='/')" ;
    ] .

t:parse-p-neg-p3
    a vsont:ParsePTest ;
    mf:name "VSON-P rejects: the input ends before the node closes" ;
    rdfs:comment "Appendix B declares no numbered error set, so the expectation pins the reference parser's message rather than an identifier the specification does not define." ;
    vsont:clause "C1" ;
    vsont:section "4.2" , "B" ;
    mf:action <data/P3_eof_inside_node.vson> ;
    mf:result [
        a vsont:ParseError ;
        vsont:errorMessage "unexpected EOF inside node" ;
    ] .

t:parse-p-neg-p4
    a vsont:ParsePTest ;
    mf:name "VSON-P rejects: a bare identifier where a role must be" ;
    rdfs:comment "Appendix B declares no numbered error set, so the expectation pins the reference parser's message rather than an identifier the specification does not define." ;
    vsont:clause "C1" ;
    vsont:section "4.2" , "B" ;
    mf:action <data/P4_expected_role.vson> ;
    mf:result [
        a vsont:ParseError ;
        vsont:errorMessage "expected role or ')', got Tok(kind='ID', value='apple')" ;
    ] .

t:parse-p-neg-p5
    a vsont:ParsePTest ;
    mf:name "VSON-P rejects: the input ends where a target must be" ;
    rdfs:comment "Appendix B declares no numbered error set, so the expectation pins the reference parser's message rather than an identifier the specification does not define." ;
    vsont:clause "C1" ;
    vsont:section "4.2" , "B" ;
    mf:action <data/P5_eof_in_term.vson> ;
    mf:result [
        a vsont:ParseError ;
        vsont:errorMessage "unexpected EOF in term" ;
    ] .

t:parse-p-neg-p6
    a vsont:ParsePTest ;
    mf:name "VSON-P rejects: a close parenthesis where a term must be" ;
    rdfs:comment "Appendix B declares no numbered error set, so the expectation pins the reference parser's message rather than an identifier the specification does not define." ;
    vsont:clause "C1" ;
    vsont:section "4.2" , "B" ;
    mf:action <data/P6_unexpected_term.vson> ;
    mf:result [
        a vsont:ParseError ;
        vsont:errorMessage "unexpected term: Tok(kind=')', value=')')" ;
    ] .

t:parse-p-neg-p7
    a vsont:ParsePTest ;
    mf:name "VSON-P rejects: a second top-level node" ;
    rdfs:comment "Appendix B declares no numbered error set, so the expectation pins the reference parser's message rather than an identifier the specification does not define." ;
    vsont:clause "C1" ;
    vsont:section "4.2" , "B" ;
    mf:action <data/P7_trailing_token.vson> ;
    mf:result [
        a vsont:ParseError ;
        vsont:errorMessage "unexpected trailing token after top-level node: Tok(kind='(', value='(')" ;
    ] .

t:parse-p-neg-p8
    a vsont:ParsePTest ;
    mf:name "VSON-P rejects: a container role given a bare reference" ;
    rdfs:comment "Appendix B declares no numbered error set, so the expectation pins the reference parser's message rather than an identifier the specification does not define." ;
    vsont:clause "C1" ;
    vsont:section "4.2" , "B" ;
    mf:action <data/P8_container_expects_node.vson> ;
    mf:result [
        a vsont:ParseError ;
        vsont:errorMessage "causal container expects nested node" ;
    ] .

