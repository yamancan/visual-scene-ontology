t:parse-p-throne-room
    a vsont:ParsePTest ;
    mf:name "the canonical throne room parses as VSON-P" ;
    vsont:clause "C1" ;
    vsont:section "4.2" , "B" ;
    mf:action <../../examples/throne_room.vson> ;
    mf:result vsont:Accepted .

t:parse-p-01-minimal
    a vsont:ParsePTest ;
    mf:name "gallery 01_minimal parses as VSON-P — minimal scene — one Composition, one Entity, one Frame" ;
    vsont:clause "C1" ;
    vsont:section "4.2" , "B" ;
    mf:action <../../examples/gallery/01_minimal.vson> ;
    mf:result vsont:Accepted .

