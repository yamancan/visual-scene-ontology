#################################################################
# Uncovered — the honest half of the coverage map.
#
# A named shape in shapes/vson-shapes.ttl with no negative entry is a build
# failure (tools/conformance_runner.py --check-coverage) unless it is listed
# here with a reason. "Nobody wrote one yet" is not a reason; the two below
# are properties of the shape.
#################################################################

t:coverage-exemptions
    a vsont:CoverageExemptions ;
    mf:name "shapes no input can exercise" ;
    vsont:exempt [
        vsont:shape vss:DepictsEntityShape ;
        rdfs:comment """Vacuous under C3's inference="rdfs". The shape asks
sh:class vso:Entity of every object of vso:depicts, and ontology/vso.ttl
declares vso:depicts rdfs:range vso:Entity, so the RDFS closure asserts the
very type the check looks for before validation begins. No document can fail
it. t:validate-pos-depicts-reification-node pins that fact from the other
side: a depicted SpatialFact — exactly what docs/vson.md §5.2 asks producers
not to write — conforms."""
    ] .
