t:validate-neg-owl-disjoint
    a vsont:ValidationTest ;
    mf:name "an individual in two disjoint classes fails the OWL 2 RL gate" ;
    rdfs:comment "No numbered clause requires internal consistency; `vson validate` runs it as its second gate and this entry pins that verdict." ;
    vsont:section "2.1" ;
    mf:action [
        sht:dataGraph <data/owl_disjoint_clash.ttl> ;
        sht:shapesGraph <../../shapes/vson-shapes.ttl> ;
        vsont:surface vsont:VSON-T
    ] ;
    mf:result [
        a sh:ValidationReport ;
        sh:conforms false ;
        vsont:gate vsont:owl-consistency ;
        sh:result [
            a sh:ValidationResult ;
            vsont:rule "vson/owl-consistency/disjoint-classes" ;
            sh:focusNode <https://example.org/scenes/owl_disjoint_clash#b> ;
            sh:value vso:Perdurant ;
            sh:resultSeverity sh:Violation ;
        ] ;
    ] .

