t:validate-pos-throne-room-t
    a vsont:ValidationTest ;
    mf:name "the canonical throne room conforms" ;
    vsont:clause "C1" , "C2" , "C3" , "C4" , "C5" , "C6" , "C7" , "C8" , "C9" ;
    vsont:section "4.1" , "5.2" , "5.3" , "5.4" , "5.5" , "5.6" , "5.7" , "5.10" , "5.11" ;
    mf:action [
        sht:dataGraph <../../examples/throne_room.ttl> ;
        sht:shapesGraph <../../shapes/vson-shapes.ttl> ;
        vsont:surface vsont:VSON-T
    ] ;
    mf:result [
        a sh:ValidationReport ;
        sh:conforms true
    ] .

