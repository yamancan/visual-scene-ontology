t:validate-pos-depicts-reification-node
    a vsont:ValidationTest ;
    mf:name "a depicted SpatialFact conforms — vss:DepictsEntityShape is vacuous" ;
    rdfs:comment "vso:depicts declares rdfs:range vso:Entity, so C3's inference=\"rdfs\" entails vso:Entity onto every object of vso:depicts and vss:DepictsEntityShape's sh:class check can never fail. The verdict is pinned so a change to the range, the shape or the inference setting has to be decided rather than discovered." ;
    vsont:clause "C3" ;
    vsont:section "5.2" ;
    mf:action [
        sht:dataGraph <data/depicts_reification_node.ttl> ;
        sht:shapesGraph <../../shapes/vson-shapes.ttl> ;
        vsont:surface vsont:VSON-T
    ] ;
    mf:result [
        a sh:ValidationReport ;
        sh:conforms true
    ] .

t:validate-neg-composition-depicts-min
    a vsont:ValidationTest ;
    mf:name "a Composition that depicts nothing fails C4" ;
    vsont:clause "C4" ;
    vsont:section "5.2" ;
    vsont:shape vss:CompositionShape ;
    mf:action [
        sht:dataGraph <data/composition_no_depicts.ttl> ;
        sht:shapesGraph <../../shapes/vson-shapes.ttl> ;
        vsont:surface vsont:VSON-T
    ] ;
    mf:result [
        a sh:ValidationReport ;
        sh:conforms false ;
        vsont:gate vsont:shacl ;
        sh:result [
            a sh:ValidationResult ;
            sh:sourceShape vss:CompositionShape ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:resultPath vso:depicts ;
            sh:focusNode <https://example.org/scenes/composition_no_depicts#scene> ;
            sh:resultSeverity sh:Violation ;
        ] ;
    ] .

