# vss:StativeShape / vso:experiencer / sh:not [ sh:class vso:Frame ] — MUST fail.
#
# docs/vson.md §5.6: the experiencer of a Stative is an Endurant. A camera
# is a Frame, and a Frame does not experience anything. The camera used is
# a second one, framing nothing: vso:experiencer entails vso:Endurant onto
# its value, and an Endurant reached by vso:framedBy would also trip
# vss:CompositionShape's guard.

@prefix vso: <https://w3id.org/vson/v1/ontology#> .
@prefix rcc: <https://w3id.org/vson/v1/rcc8#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix :    <https://example.org/scenes/stative_experiencer_frame#> .

:scene a vso:Composition ;
    vso:framedBy :cam ;
    vso:viewedBy :cam ;
    vso:depicts  :a , :b .

:cam a vso:CameraView ; vso:angle "eye_level" ; vso:framing "medium_shot" .

:a a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing .

:b a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing .

:cam2 a vso:CameraView ; vso:angle "high" ; vso:framing "close_up" .

:scene vso:occurs :st .

:st a vso:Stative ; vso:lemma "hold" ;
    vso:experiencer :cam2 .
