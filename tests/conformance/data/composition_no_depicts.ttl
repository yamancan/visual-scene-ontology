# vss:CompositionShape / vso:depicts / sh:minCount — MUST fail.
#
# C4: every Composition depicts at least one Entity. This one frames a
# camera and depicts nothing, which is the clause stated as a shape.

@prefix vso: <https://w3id.org/vson/v1/ontology#> .
@prefix rcc: <https://w3id.org/vson/v1/rcc8#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix :    <https://example.org/scenes/composition_no_depicts#> .

:scene a vso:Composition ;
    vso:framedBy :cam ;
    vso:viewedBy :cam .

:cam a vso:CameraView ; vso:angle "eye_level" ; vso:framing "medium_shot" .

:a a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing .

:b a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing .
