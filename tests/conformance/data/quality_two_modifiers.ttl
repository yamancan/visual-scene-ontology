# vss:QualityModifierShape / vso:modifier / sh:maxCount — MUST fail.
#
# ontology/vso.ttl declares vso:modifier 0..1 and names the shape that
# enforces it. Two adverbs on one reading are undecided, not richer.

@prefix vso: <https://w3id.org/vson/v1/ontology#> .
@prefix rcc: <https://w3id.org/vson/v1/rcc8#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix :    <https://example.org/scenes/quality_two_modifiers#> .

:scene a vso:Composition ;
    vso:framedBy :cam ;
    vso:viewedBy :cam ;
    vso:depicts  :a , :b .

:cam a vso:CameraView ; vso:angle "eye_level" ; vso:framing "medium_shot" .

:a a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing .

:b a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing .

:a vso:hasQuality :q .

:q a vso:Quality ; vso:dimension vso:Color ; vso:value "red" ;
   vso:modifier "dark" , "very" .
