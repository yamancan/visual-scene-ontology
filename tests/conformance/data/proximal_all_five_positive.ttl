# Positive — all five proximity relations, one fact each.
#
# docs/vson.md §5.12 closes vso:proximal at five values and no shipped
# document carries any of them. An enum nothing exercises is an enum
# nothing checks.

@prefix vso: <https://w3id.org/vson/v1/ontology#> .
@prefix rcc: <https://w3id.org/vson/v1/rcc8#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix :    <https://example.org/scenes/proximal_all_five_positive#> .

:scene a vso:Composition ;
    vso:framedBy :cam ;
    vso:viewedBy :cam ;
    vso:depicts  :a , :b ;
    vso:hasFact  :near , :far , :adjacent , :next_to , :facing .

:cam a vso:CameraView ; vso:angle "eye_level" ; vso:framing "medium_shot" .

:a a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing .

:b a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing .

:near     a vso:SpatialFact ; vso:figure :a ; vso:ground :b ; vso:proximal vso:near .
:far      a vso:SpatialFact ; vso:figure :a ; vso:ground :b ; vso:proximal vso:far .
:adjacent a vso:SpatialFact ; vso:figure :a ; vso:ground :b ; vso:proximal vso:adjacent .
:next_to  a vso:SpatialFact ; vso:figure :a ; vso:ground :b ; vso:proximal vso:next_to .
:facing   a vso:SpatialFact ; vso:figure :a ; vso:ground :b ; vso:proximal vso:facing .
