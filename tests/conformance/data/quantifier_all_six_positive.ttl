# Positive — every value of the closed quantifier list.
#
# docs/vson.md §5.11 closes vso:quantifier at six values and the gallery
# exercises one of them.

@prefix vso: <https://w3id.org/vson/v1/ontology#> .
@prefix rcc: <https://w3id.org/vson/v1/rcc8#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix :    <https://example.org/scenes/quantifier_all_six_positive#> .

:scene a vso:Composition ;
    vso:framedBy :cam ;
    vso:viewedBy :cam ;
    vso:depicts  :a , :b ;
    vso:hasFact  :q1 , :q2 , :q3 , :q4 , :q5 , :q6 .

:cam a vso:CameraView ; vso:angle "eye_level" ; vso:framing "medium_shot" .

:a a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing .

:b a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing .

:q1 a vso:Quantification ; vso:quantifier "all"   ; vso:variable "x" ; vso:scope :a .
:q2 a vso:Quantification ; vso:quantifier "every" ; vso:variable "x" ; vso:scope :a .
:q3 a vso:Quantification ; vso:quantifier "some"  ; vso:variable "x" ; vso:scope :a .
:q4 a vso:Quantification ; vso:quantifier "no"    ; vso:variable "x" ; vso:scope :a .
:q5 a vso:Quantification ; vso:quantifier "most"  ; vso:variable "x" ; vso:scope :a .
:q6 a vso:Quantification ; vso:quantifier "few"   ; vso:variable "x" ; vso:scope :a .
