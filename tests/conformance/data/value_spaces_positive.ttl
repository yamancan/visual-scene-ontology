# Positive — the numeric and geometric value spaces at their boundaries.
#
# The value spaces v1.3 closed (docs/vson.md §8.2): bbox2d, position3d,
# scale3d, rotation in both admitted arities, and the three [0,1] numbers
# at 0 and at 1. A bound that rejects its own endpoints is the wrong bound,
# and this is where that would show.

@prefix vso: <https://w3id.org/vson/v1/ontology#> .
@prefix rcc: <https://w3id.org/vson/v1/rcc8#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix :    <https://example.org/scenes/value_spaces_positive#> .

:scene a vso:Composition ;
    vso:framedBy :cam ;
    vso:viewedBy :cam ;
    vso:depicts  :a , :b .

:cam a vso:CameraView ; vso:angle "eye_level" ; vso:framing "medium_shot" .

:a a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing ;
    vso:bbox2d "0,0,1,1" ;
    vso:position3d "-1.5,0,2.25e2" ;
    vso:scale3d "1,1,1" ;
    vso:rotation "0,0,0,1" ;
    vso:visibleFraction 0 .

:b a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing ;
    vso:bbox2d "0.10,0.20,0.30,0.40" ;
    vso:rotation "0,1.0,-0.5" ;
    vso:visibleFraction 1 .

:a vso:hasQuality :q .

:q a vso:Quality ; vso:dimension vso:Color ; vso:value "red" ; vso:modifier "dark" .

:scene vso:hasFact :ann .

:ann a vso:Annotation ;
     vso:annotatedSubject   :a ;
     vso:annotatedPredicate vso:class ;
     vso:annotatedObject    :Thing ;
     vso:probability 0 ;
     vso:confidence  1 .
