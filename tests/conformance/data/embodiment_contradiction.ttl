# vss:EmbodimentConsistencyShape / sh:sparql — MUST warn (sh:Warning).
#
# docs/vson.md §5.3: an Entity that embodies a Persona should not contradict
# that Persona's invariants on the same dimension. Warning, not Violation:
# extractor noise on a cross-document identity is expected.

@prefix vso: <https://w3id.org/vson/v1/ontology#> .
@prefix rcc: <https://w3id.org/vson/v1/rcc8#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix :    <https://example.org/scenes/embodiment_contradiction#> .

:scene a vso:Composition ;
    vso:framedBy :cam , :p ;
    vso:viewedBy :cam ;
    vso:depicts  :a , :b .

:cam a vso:CameraView ; vso:angle "eye_level" ; vso:framing "medium_shot" .

:a a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing .

:b a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing .

:p a vso:Persona ; vso:personaId "kb:queen" ;
   vso:hasInvariant :inv .

:inv a vso:Quality ; vso:dimension vso:Color ; vso:value "gold" .

:a vso:embodies :p ;
   vso:hasQuality :obs .

:obs a vso:Quality ; vso:dimension vso:Color ; vso:value "silver" .
