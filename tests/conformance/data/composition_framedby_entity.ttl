# vss:CompositionShape / vso:framedBy / sh:not [ sh:class vso:Entity ] — MUST fail.
#
# docs/vson.md §5.2: vso:framedBy references a Frame. The range entails
# vso:Frame onto every value, so the asserted PhysicalObject type is what
# the sh:not guard sees — the trap the shapes file's NB describes. The
# offending entity is deliberately NOT depicted: a depicted one would also
# trip vss:FrameNotDepictedShape and this document would test two shapes.

@prefix vso: <https://w3id.org/vson/v1/ontology#> .
@prefix rcc: <https://w3id.org/vson/v1/rcc8#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix :    <https://example.org/scenes/composition_framedby_entity#> .

:scene a vso:Composition ;
    vso:framedBy :cam , :c ;
    vso:viewedBy :cam ;
    vso:depicts  :a , :b .

:cam a vso:CameraView ; vso:angle "eye_level" ; vso:framing "medium_shot" .

:a a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing .

:b a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing .

:c a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing .
