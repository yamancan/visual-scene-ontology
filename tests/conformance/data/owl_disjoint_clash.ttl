# OWL 2 RL gate — SHACL green, closure inconsistent.
#
# docs/vson.md §2.1: internal consistency is the construct no numbered
# clause requires and `vson validate` runs anyway. Endurant and Perdurant
# are declared disjoint; this document puts one individual in both, and
# the rdfs-level SHACL gate cannot see it.

@prefix vso: <https://w3id.org/vson/v1/ontology#> .
@prefix rcc: <https://w3id.org/vson/v1/rcc8#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix :    <https://example.org/scenes/owl_disjoint_clash#> .

:scene a vso:Composition ;
    vso:framedBy :cam ;
    vso:viewedBy :cam ;
    vso:depicts  :a , :b .

:cam a vso:CameraView ; vso:angle "eye_level" ; vso:framing "medium_shot" .

:a a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing .

:b a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing .

:scene vso:occurs :b .

:b a vso:Event ; vso:lemma "fall" .
