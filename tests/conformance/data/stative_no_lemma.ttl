# vss:StativeShape / vso:lemma / sh:minCount — MUST fail.
#
# C6, on the third perdurant class. Through v1.2 only vss:EventShape capped
# the count; the presence half was always shaped on all three.

@prefix vso: <https://w3id.org/vson/v1/ontology#> .
@prefix rcc: <https://w3id.org/vson/v1/rcc8#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix :    <https://example.org/scenes/stative_no_lemma#> .

:scene a vso:Composition ;
    vso:framedBy :cam ;
    vso:viewedBy :cam ;
    vso:depicts  :a , :b .

:cam a vso:CameraView ; vso:angle "eye_level" ; vso:framing "medium_shot" .

:a a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing .

:b a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Thing .

:scene vso:occurs :st .

:st a vso:Stative ; vso:experiencer :a .
