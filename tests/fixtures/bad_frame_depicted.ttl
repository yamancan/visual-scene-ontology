# Negative SHACL fixture: a Composition tries to depict a Frame.
# MUST fail vss:FrameNotDepictedShape (Frame ≠ Entity).

@prefix vso: <https://vson.dev/v1/ontology#> .
@prefix :    <https://example.org/scenes/bad2#> .

:c a vso:Composition ;
   vso:depicts :cam .  # ← Frame is not an Entity; this MUST fail.

:cam a vso:CameraView .
