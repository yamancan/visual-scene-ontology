# Negative SHACL fixture: a directional SpatialFact anchored to two viewers.
# MUST fail vss:DirectionalNeedsViewerShape (sh:maxCount).
#
# The other gap docs/vson.md §2.1 named: C5 requires exactly one vso:viewer on a
# directional fact and the shape checked presence only. Two cameras is two
# construals of "left_of" — the ambiguity viewer anchoring exists to remove
# (§3.3).

@prefix vso: <https://w3id.org/vson/v1/ontology#> .
@prefix rcc: <https://w3id.org/vson/v1/rcc8#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix :    <https://example.org/scenes/two_viewers#> .

:scene a vso:Composition ;
    vso:framedBy :cam ;
    vso:viewedBy :cam ;
    vso:depicts  :lamp , :chair .

:cam a vso:CameraView ; vso:angle "eye_level" ; vso:framing "wide_shot" .

:lamp a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Lamp .

:chair a vso:PhysicalObject ;
    vso:individuation vso:Generic ; vso:animacy vso:Inert ;
    vso:countability vso:Count ; vso:class :Furniture .

:cam2 a vso:CameraView ; vso:angle "high" .
:scene vso:framedBy :cam2 ; vso:hasFact :sf .

:sf a vso:SpatialFact ;
    vso:figure :lamp ; vso:ground :chair ;
    vso:directional vso:left_of ;
    vso:viewer :cam , :cam2 .   # <- two viewers; MUST fail C5.
