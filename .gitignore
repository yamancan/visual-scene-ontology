__pycache__/
*.pyc
.venv/
.env
.DS_Store
/tmp/
*.swp
.pytest_cache/
*.egg-info/
build/
dist/

# Local Claude Code settings (personal paths)
.claude/

# Baseline measurement artifacts (regenerated via extract.py --live)
tools/extractor/baseline/images/*
!tools/extractor/baseline/images/.gitkeep
tools/extractor/baseline/results*.csv

# Rust build artifacts
cli/target/

# Web app artifacts (web/.gitignore owns web/.env and its variants)
web/node_modules/
web/.svelte-kit/
web/build/

# Markdown files — do not commit, in any subfolder.
# Existing tracked .md files (README.md, docs/vson.md, spec/*.md, etc.)
# remain tracked; this rule only blocks NEW .md from being staged.
*.md

# Stray example images — the curated examples/ corpus is .vson/.ttl text.
examples/*.jpg
examples/*.jpeg
examples/*.png
