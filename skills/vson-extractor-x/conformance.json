{
  "$comment": "Acceptance fixture for any model that wants to claim VSON-X-extractor support. Each entry references an image bundled with the studio. Same images as vson-extractor — graph topology should match modulo the single SpatialFact-edge collapse documented in docs/vson-x-semantics.md §4.4. A model passes if at least 4/5 envelopes conform on first try, AND the Talmy-gate fixture (street) MUST conform.",
  "version": "1.0.0",
  "skill": "vson-extractor-x",
  "output": "vson_x",
  "target_first_try": 0.7,
  "target_after_repair": 0.85,
  "test_corpus": "examples/gallery-x/*.x.vson",
  "evaluator": "make x-skill-check",
  "ci_gate": true,
  "fixtures": [
    {
      "image": "../../web/static/demos/kitchen.jpg",
      "label": "kitchen",
      "gate": "mass_countability",
      "expected": { "conforms": true, "nodes": [12, 28], "edges": [22, 50] }
    },
    {
      "image": "../../web/static/demos/street.jpg",
      "label": "street",
      "gate": "talmy_directional",
      "must_conform": true,
      "expected": { "conforms": true, "nodes": [10, 30], "edges": [18, 55] }
    },
    {
      "image": "../../web/static/demos/forest.jpg",
      "label": "forest",
      "expected": { "conforms": true, "nodes": [6, 22], "edges": [10, 40] }
    },
    {
      "image": "../../web/static/demos/books.jpg",
      "label": "books",
      "expected": { "conforms": true, "nodes": [6, 24], "edges": [10, 45] }
    },
    {
      "image": "../../web/static/demos/lamp.jpg",
      "label": "lamp",
      "expected": { "conforms": true, "nodes": [4, 14], "edges": [6, 26] }
    }
  ],
  "thresholds": {
    "first_try_pass_rate_min": 0.8,
    "max_repair_retries": 2,
    "talmy_gate_must_pass": true
  }
}
