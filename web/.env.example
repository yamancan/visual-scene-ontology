# Required: OpenRouter API key. Get one at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# Optional: override the default model (default: google/gemini-2.5-flash).
# Any OpenRouter-supported vision model works; results will vary.
# Cheap+fast: google/gemini-2.5-flash, google/gemini-2.5-flash-lite.
# Premium: anthropic/claude-opus-4.6, anthropic/claude-sonnet-4.6.
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Optional: path to the `vson` binary. Default: ../cli/target/release/vson.
# VSON_BIN=/usr/local/bin/vson

# Optional: public base URL for HTTP-Referer header sent to OpenRouter.
# PUBLIC_BASE_URL=https://studio.vson.dev

# Optional: comma-separated allowlist narrowing which OpenRouter models
# clients may request (default: any model on OpenRouter's live list).
# OPENROUTER_ALLOWED_MODELS=google/gemini-2.5-flash,anthropic/claude-sonnet-4.6

# Optional: per-IP rate limit for POST /api/extract and /api/correct
# (defaults: 10 requests per 600 seconds).
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_S=600

# Node deploys only (`node build`): adapter-node caps request bodies at 512K
# by default, which rejects images over ~380KB with a 413. Required for the
# advertised 5MB uploads:
# BODY_SIZE_LIMIT=8M
