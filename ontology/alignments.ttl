    a skos:Concept ;
    skos:inScheme vsa:AffordanceScheme ;
    skos:topConceptOf vsa:AffordanceScheme ;
    skos:prefLabel "Container"@en ;
    skos:definition "Can hold other things inside it."@en .
vso:Edible
    a skos:Concept ;
    skos:inScheme vsa:AffordanceScheme ;
    skos:topConceptOf vsa:AffordanceScheme ;
    skos:prefLabel "Edible"@en ;
    skos:definition "Can be eaten or drunk."@en .
vso:Holdable
    a skos:Concept ;
    skos:inScheme vsa:AffordanceScheme ;
    skos:topConceptOf vsa:AffordanceScheme ;
    skos:prefLabel "Holdable"@en ;
    skos:definition "Can be grasped and carried in the hand."@en .
vso:Mountable
    a skos:Concept ;
