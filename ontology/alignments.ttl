# vso:directional — 6 value(s). Direction
vsa:DirectionScheme
    a skos:ConceptScheme ;
    rdfs:label "Direction scheme"@en ;
    rdfs:comment "SKOS view of the closed value vocabulary vso:Direction, which is the value space of vso:directional (docs/vson.md §5.12)."@en ;
    rdfs:isDefinedBy <https://w3id.org/vson/v1/alignments> ;
    vs:term_status "stable" ;
    dc:source vso:Direction ;
    skos:prefLabel "Direction scheme"@en ;
    skos:hasTopConcept vso:above ,
        vso:behind ,
        vso:below ,
        vso:in_front_of ,
        vso:left_of ,
        vso:right_of .

vso:above
    a skos:Concept ;
    skos:inScheme vsa:DirectionScheme ;
    skos:topConceptOf vsa:DirectionScheme ;
    skos:prefLabel "above"@en ;
    skos:definition "The figure is higher than the ground in the viewer's frame."@en .
vso:behind
    a skos:Concept ;
    skos:inScheme vsa:DirectionScheme ;
    skos:topConceptOf vsa:DirectionScheme ;
    skos:prefLabel "behind"@en ;
    skos:definition "The figure is further from the viewer than the ground is."@en .
vso:below
    a skos:Concept ;
    skos:inScheme vsa:DirectionScheme ;
    skos:topConceptOf vsa:DirectionScheme ;
    skos:prefLabel "below"@en ;
    skos:definition "The figure is lower than the ground in the viewer's frame."@en .
vso:in_front_of
    a skos:Concept ;
    skos:inScheme vsa:DirectionScheme ;
    skos:topConceptOf vsa:DirectionScheme ;
    skos:prefLabel "in_front_of"@en ;
    skos:definition "The figure is nearer to the viewer than the ground is."@en .
vso:left_of
    a skos:Concept ;
    skos:inScheme vsa:DirectionScheme ;
    skos:topConceptOf vsa:DirectionScheme ;
    skos:prefLabel "left_of"@en ;
    skos:definition "The figure is to the viewer's left of the ground."@en .
vso:right_of
    a skos:Concept ;
    skos:inScheme vsa:DirectionScheme ;
    skos:topConceptOf vsa:DirectionScheme ;
    skos:prefLabel "right_of"@en ;
    skos:definition "The figure is to the viewer's right of the ground."@en .


# vso:proximal — 5 value(s). ProximityKind
vsa:ProximityScheme
    a skos:ConceptScheme ;
    rdfs:label "ProximityKind scheme"@en ;
    rdfs:comment "SKOS view of the closed value vocabulary vso:ProximityKind, which is the value space of vso:proximal (docs/vson.md §5.12)."@en ;
    rdfs:isDefinedBy <https://w3id.org/vson/v1/alignments> ;
    vs:term_status "stable" ;
    dc:source vso:ProximityKind ;
    skos:prefLabel "ProximityKind scheme"@en ;
    skos:hasTopConcept vso:adjacent ,
        vso:facing ,
        vso:far ,
        vso:near ,
        vso:next_to .

vso:adjacent
    a skos:Concept ;
    skos:inScheme vsa:ProximityScheme ;
    skos:topConceptOf vsa:ProximityScheme ;
    skos:prefLabel "adjacent"@en ;
    skos:definition "The figure is immediately beside the ground, with nothing between them."@en .
vso:facing
    a skos:Concept ;
    skos:inScheme vsa:ProximityScheme ;
    skos:topConceptOf vsa:ProximityScheme ;
    skos:prefLabel "facing"@en ;
    skos:definition "The figure is turned toward the ground."@en .
vso:far
    a skos:Concept ;
    skos:inScheme vsa:ProximityScheme ;
    skos:topConceptOf vsa:ProximityScheme ;
    skos:prefLabel "far"@en ;
    skos:definition "The figure is distant from the ground relative to the scale of the scene."@en .
vso:near
    a skos:Concept ;
    skos:inScheme vsa:ProximityScheme ;
    skos:topConceptOf vsa:ProximityScheme ;
    skos:prefLabel "near"@en ;
    skos:definition "The figure is close to the ground relative to the scale of the scene."@en .
vso:next_to
    a skos:Concept ;
    skos:inScheme vsa:ProximityScheme ;
    skos:topConceptOf vsa:ProximityScheme ;
    skos:prefLabel "next_to"@en ;
    skos:definition "The figure is beside the ground, without the no-gap reading vso:adjacent asserts."@en .
