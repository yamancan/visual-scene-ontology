@prefix rcc:  <https://vson.dev/v1/rcc8#> .
@prefix vso:  <https://vson.dev/v1/ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://vson.dev/v1/rcc8>
    a owl:Ontology ;
    rdfs:label "RCC-8 spatial topology" ;
    rdfs:comment "Region Connection Calculus 8 base relations, jointly exhaustive and pairwise disjoint." .

# RCC-8 base relations as instances of a relation class so they can be values
# of vso:rcc on a SpatialFact. (The relations are the eight values, not edge predicates.)
rcc:Relation a owl:Class .

rcc:DC    a rcc:Relation ; rdfs:label "DC"    ; rdfs:comment "Disconnected." .
rcc:EC    a rcc:Relation ; rdfs:label "EC"    ; rdfs:comment "Externally connected (touching, no overlap)." .
rcc:PO    a rcc:Relation ; rdfs:label "PO"    ; rdfs:comment "Partial overlap." .
rcc:EQ    a rcc:Relation ; rdfs:label "EQ"    ; rdfs:comment "Equal regions." .
rcc:TPP   a rcc:Relation ; rdfs:label "TPP"   ; rdfs:comment "Tangential proper part." .
rcc:NTPP  a rcc:Relation ; rdfs:label "NTPP"  ; rdfs:comment "Non-tangential proper part." .
rcc:TPPi  a rcc:Relation ; rdfs:label "TPPi"  ; rdfs:comment "Inverse of TPP." .
rcc:NTPPi a rcc:Relation ; rdfs:label "NTPPi" ; rdfs:comment "Inverse of NTPP." .

# JEPD: pairwise disjoint, jointly exhaustive
[] a owl:AllDifferent ;
   owl:distinctMembers ( rcc:DC rcc:EC rcc:PO rcc:EQ rcc:TPP rcc:NTPP rcc:TPPi rcc:NTPPi ) .
