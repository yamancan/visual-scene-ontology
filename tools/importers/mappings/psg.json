{
  "dataset": "psg",
  "_provenance": {
    "vocabulary_source": "the predicate table published in the OpenPSG README, https://github.com/Jingkang50/OpenPSG (retrieved 2026-08-03)",
    "vocabulary_measured": "56 predicates in seven groups, as published; no token frequencies, because psg.json is not fetchable from a stable public URL",
    "format_documentation": "openpsg/datasets/psg.py in the same repository (retrieved 2026-08-03)",
    "note": "the four parenthesised alternates in the published table (picking (grabbing), cleaning (washing, brushing), throwing (tossing), enclosing (surrounding, warping in)) are carried as extra keys marked variant_of, because the exact strings psg.json writes were not read.",
    "authored": "entries written against the published predicate table; maintained by hand thereafter"
  },
  "policy": {
    "individuation": "Skolem",
    "_individuation_why": "ontology/vso.ttl reads vso:Skolem as 'a particular but unnamed individual, tracked within the document by a minted handle' — which is exactly what an annotated region with an object id is. Generic would say 'a knight, not a particular knight', which is not what an annotation of one image says.",
    "countability_default": "Count",
    "_countability_default_why": "an annotated region is a bounded individual unless the label says otherwise; object_classes carries the Mass and Collective exceptions and the count of defaulted traits is in every lossiness report."
  },
